# Copy this file to `.env` for local development (never commit `.env`).
# In production, add the same variables in Vercel → Project → Settings → Environment Variables, then redeploy.
# VITE_* values are baked in at build time, so a change needs a new build.

# Google Apps Script web-app URL that emails every enquiry and callback request to BRAND.email.
# Setup steps: docs/enquiry-emails.md. Leave empty to keep enquiries saved locally only.
VITE_ENQUIRY_EMAIL_URL=https://script.google.com/macros/s/XXXX/exec
